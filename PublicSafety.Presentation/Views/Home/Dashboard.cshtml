
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <h1 class="mr-5">مرحبًا بك، {{LogedInUser.username}}</h1>
</div>

<div class="content">

    
    <div class="d-flex">


        <!-- Main Dashboard -->
        <div class="flex-grow-1 mb-3">


            <!-- KPI Cards -->
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card shadow p-3">
                        <h5>عدد الموظفين الكلي</h5>
                        <h2>{{activeEmployeesCount}}</h2>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow p-3">
                        <h5>عدد المستقيلين الكلي</h5>
                        <h2>{{inactiveEmployeesCount}}</h2>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow p-3">
                        <h5>عدد المواد الكلي</h5>
                        <h2>{{itemsCount}}</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">


        <!-- Table -->
        <div class="col-md-6">
            <div class="card card-default h-100">
                <div class="card-header">
                    <h3>تفاصيل التخطيط</h3>
                </div>

                <div class="card-body">
                    <table ng-table="planningTableParams"
                           class="table table-bordered table-striped text-center" style="cursor:pointer;">

                        <tr ng-repeat="row in $data" ng-click="openYearDetails(row.Year)">
                            <td data-title="'السنة'">
                                {{row.Year}}
                            </td>

                            <td data-title="'عدد الموظفين'">
                                {{row.EmployeesCount}}
                            </td>

                            <td data-title="'المخطط'">
                                {{row.Planned}}
                            </td>

                            <td data-title="'المصروف'">
                                {{row.Issued}}
                            </td>
                        </tr>

                    </table>

                    <div ng-show="planningData.length === 0"
                         class="text-danger text-center mt-2">
                        لا توجد بيانات
                    </div>
                </div>
            </div>
        </div>
        <!-- Chart -->
        <div class="col-md-6">
            <div class="card card-default h-100">
                <div class="card-header">
                    <h2>التخطيط السنوي للاحتياج</h2>
                </div>
                <div class="card-body">
                    <canvas id="planningChart" height="160"></canvas>
                </div>
            </div>
        </div>
    </div>



</div>







<div class="modal fade" id="planningDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    تفاصيل التخطيط لسنة {{selectedYear}}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <table ng-table="detailsTableParams"
                       class="table table-striped table-bordered text-center">

                    <tr ng-repeat="item in $data" >
                        <td data-title="'المادة'">{{item.ItemName}}</td>
                        <td data-title="'الكمية المخططة'">{{item.PlannedQty}}</td>
                    </tr>
                </table>

            </div>

        </div>
    </div>
</div>

