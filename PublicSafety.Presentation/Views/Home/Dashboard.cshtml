
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <h1 class="mr-5">مرحبًا بك، {{LogedInUser.username}}</h1>
</div>

<div class="content">


    <div class="d-flex">


        <!-- Main Dashboard -->
        <div class="flex-grow-1 mb-3">


            <!-- KPI Cards -->
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card shadow p-3">
                        <h5>عدد الموظفين الكلي</h5>
                        <h2>{{activeEmployeesCount}}</h2>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow p-3">
                        <h5>عدد المستقيلين الكلي</h5>
                        <h2>{{inactiveEmployeesCount}}</h2>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow p-3">
                        <h5>عدد المواد الكلي</h5>
                        <h2>{{itemsCount}}</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Chart -->
        <div class="col-md-6">
            <div class="card card-default h-100">
                <div class="card-header">
                    <h2>التخطيط السنوي للاحتياج</h2>
                </div>
                <div class="card-body">
                    <canvas id="planningChart" height="160"></canvas>
                </div>
            </div>
           
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">

                <!-- Card Header -->
                <div class="card-header active text-white text-center">
                    <h5 class="mb-0">
                        <i class="mdi mdi-account-group"></i>
                        الموظفون
                    </h5>
                </div>

                <!-- Card Body -->
                <div class="card-body text-center">

                    <!-- Total Employees -->
                    <h1 class="display-4 font-weight-bold">
                        {{activeEmployeesCount}}
                    </h1>
                    <p class="text-muted mb-3">إجمالي عدد الموظفين</p>

                    <hr />

                    <!-- Employees by Category -->
                    <ul class="list-group list-group-flush text-right">
                        <li class="list-group-item d-flex justify-content-between align-items-center"
                            ng-repeat="c in employeesByCategory">
                            <span>
                                <i class="mdi mdi-briefcase-outline text-secondary mr-1"></i>
                                {{c.CategoryName}}
                            </span>
                            <span class="badge badge-primary active badge-pill">
                                {{c.EmployeeCount}}
                            </span>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">

        <!-- Table -->
        <div class="col-md-12">
            <div class="card card-default h-100">
                <div class="card-header">
                    <h3>تفاصيل التخطيط</h3>
                </div>

                <div class="card-body">

                    <table ng-table="planningTableParams"
                           class="table table-bordered table-striped text-center"
                           style="cursor:pointer;">

                       
                        <thead>
                            <tr>
                                <th rowspan="2">السنة</th>
                                <th rowspan="2">عدد الموظفين</th>
                                <th rowspan="2">المخطط</th>
                                <th colspan="5">المصروف</th>
                            </tr>
                            <tr>
                                <th>الإجمالي</th>
                                <th>استحقاق</th>
                                <th>استثناء</th>
                                <th>بدل تالف</th>
                                <th>إتلاف</th>
                            </tr>
                        </thead>

                      
                        <tbody>
                            <tr class="t-hover" ng-repeat="row in $data"
                                ng-click="openYearDetails(row.Year)">

                                <td >{{row.Year}}</td>

                                <td>{{row.EmployeesCount}}</td>

                                <td>{{row.Planned}}</td>

                                <!-- Issued Summary -->
                                <td class="font-weight-bold text-black t-hover">
                                    {{row.Issued.Total}}
                                </td>

                                <td>{{row.Issued.Entitled}}</td>

                                <td>{{row.Issued.Exception}}</td>

                                <td>{{row.Issued.Damaged}}</td>

                                <td>{{row.Issued.Disposed}}</td>
                            </tr>
                        </tbody>

                    </table>

                    <div ng-show="planningData.length === 0"
                         class="text-danger text-center mt-2">
                        لا توجد بيانات
                    </div>

                </div>
            </div>
        </div>


    </div>



</div>







<div class="modal fade" id="planningDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    تفاصيل التخطيط لسنة {{selectedYear}}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <table ng-table="detailsTableParams"
                       class="table table-striped table-bordered text-center">

                    <tr ng-repeat="item in $data" >
                        <td data-title="'المادة'">{{item.ItemName}}</td>
                        <td data-title="'الكمية المخططة'">{{item.PlannedQty}}</td>
                    </tr>
                </table>

            </div>

        </div>
    </div>
</div>

