
@{
    ViewBag.Title = "Employees";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="content" dir="rtl">

    <!-- Employees Inventory -->
    <div class="card card-default" dir="rtl">

        <div class="card-header">

            <div class="row mb-3">
                <h2 class="mb-0">قائمة الموظفين</h2>
            </div>



        </div>

        <div class="card-body p-2">

            <!-- ✅ Top Actions Toolbar -->
            <div class="row align-items-center mb-3" ng-if="!hasRole(2)">
 
                <!-- Excel Dropdown -->
                <div class="col-md-3">
                    <div class="btn-group w-100">
                        <button type="button"
                                class="btn btn-light border dropdown-toggle w-100"
                                data-bs-toggle="dropdown">
                            <i class="fa fa-file-excel"></i>
                            اكسل
                        </button>

                        <ul class="dropdown-menu w-100 small">

                            <li>
                                <a class="dropdown-item text-truncate"
                                   href="/Upload/DownloadEmployeeTemplate">
                                    تنزيل نموذج الموظفين
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   data-bs-toggle="modal"
                                   data-bs-target="#uploadEmployeesModal" href="">
                                    رفع ملف الموظفين
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   href="/Upload/DownloadAllEmployees">
                                    تنزيل ملف الموظفين
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item text-truncate"
                                   href="javascript:void(0)"
                                   ng-click="openExportEntitlementsModal()">
                                    تنزيل استحقاقات الموظفين
                                </a>
                            </li>

                        </ul>
                    </div>
                </div>

                <!-- Issue Category Button -->
                <div class="col-md-3">
                    <button type="button"
                            class="btn btn-info w-100"
                            ng-click="openEntitleMatrixModal()">
                        <i class="fa fa-box"></i>
                        صرف لفئة
                    </button>
                </div>

                <!-- Add Employee Button -->
                <div class="col-md-3">
                    <button type="button"
                            class="btn btn-success w-100"
                            ng-click="GoToAddPage()">
                        <i class="fa fa-user-plus"></i>
                        إضافة موظف
                    </button>
                </div>

            </div>

        </div>

        <div class="card p-3 mb-3 shadow-sm">

            <!-- ✅ Row 1 -->
            <div class="row g-2">

                <!-- Full Name -->
                <div class="col-md-4">
                    <label class="form-label">اسم الموظف</label>
                    <input type="text"
                           class="form-control"
                           placeholder="بحث باسم الموظف"
                           ng-model="search.FullName" />
                </div>

                <!-- Employee Number -->
                <div class="col-md-4">
                    <label class="form-label">الرقم الوظيفي</label>
                    <input type="text"
                           class="form-control"
                           placeholder="بحث بالرقم الوظيفي"
                           ng-model="search.EmployeeNumber" />
                </div>

                <!-- Active -->
                <div class="col-md-4">
                    <label class="form-label">الحالة</label>
                    <select class="form-control"
                            ng-model="search.Active">
                        <option value="">الكل</option>
                        <option value="true">فعّال</option>
                        <option value="false">متقاعد</option>
                    </select>
                </div>

            </div>


            <!-- ✅ Row 2 -->
            <div class="row g-2 mt-2">

                <!-- Department -->
                <div class="col-md-4">
                    <label class="form-label">الوحدة التنظيمية</label>
                    <select class="form-control"
                            ng-model="search.DepartmentId"
                            ng-click="loadDepartments()"
                            ng-options="d.DepartmentId as d.Name for d in Departments"
                            ng-change="loadSectionsByDepartment(search.DepartmentId)">
                        <option value="">كل الوحدات</option>
                    </select>
                </div>

                <!-- Section -->
                <div class="col-md-4">
                    <label class="form-label">القسم</label>
                    <select class="form-control"
                            ng-model="search.SectionId"
                            ng-click="loadSections()"
                            ng-options="s.SectionId as s.Name for s in sections">
                        <option value="">كل الأقسام</option>
                    </select>
                </div>

                <!-- Category -->
                <div class="col-md-4">
                    <label class="form-label">التصنيف</label>
                    <select class="form-control"
                            ng-model="search.CategoryId"
                            ng-options="c.CategoryId as c.Name for c in Categories">
                        <option value="">كل التصنيفات</option>
                    </select>
                </div>

            </div>


            <!-- ✅ Buttons Row -->
            <div class="row mt-3">
                <div class="col-md-12 text-end">

                    <!-- Search Button -->
                    <button class="btn btn-primary search px-4"
                            ng-click="applySearch()">
                        <i class="fa fa-search"></i>
                        بحث
                    </button>

                    <!-- Reset Button (optional) -->
                    <button class="btn btn-secondary reset px-4 ms-2"
                            ng-click="resetSearch()">
                        <i class="fa fa-refresh"></i>
                        إعادة ضبط
                    </button>

                </div>
            </div>

        </div>




    </div>




    <div class="card">

        <table class="table table-hover table-bordered text-center" ng-table="employeesTableParams">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>الرقم الوظيفي</th>
                    <th>الاسم</th>
                    <th>التصنيف</th>
                    <th>الوحدة التنظيمية</th>
                    <th>القسم/الشعبة</th>
                    <th>المسمى الوظيفي</th>
                    <th>الموقع</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="employee in $data">
                    <td>{{$index + 1}}</td>
                    <td><span class="text-dark">{{employee.EmployeeNumber}}</span></td>
                    <td>
                        {{employee.FullName}}
                        <div>
                            <small class="text-muted">
                                <span class="text-danger" ng-show="!employee.Active">مستقيل</span>
                            </small>
                        </div>
                    </td>
                    <td>{{employee.Category}}</td>
                    <td>{{employee.Department}}</td>
                    <td>{{employee.Section}}</td>
                    <td>{{employee.JobTitle}}</td>
                    <td>
                        <span ng-show="employee.WorkLocationStr == 'Amman'">عمان</span>
                        <span ng-show="employee.WorkLocationStr == 'Khaldieh'">الخالدية</span>
                    </td>
                    <td>
                        <div class="btn-group">
                            <button type="button" class="btn btn-success dropdown-toggle actions" data-bs-toggle="dropdown"></button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#!/editEmployee/{{employee.EmployeeId}}" ng-if="employee.Active && !hasRole(2)">تعديل</a></li>
                                <li><a class="dropdown-item" href="" ng-click="openUpdateJobTitleModal(employee)" ng-if="employee.Active && !hasRole(2)">تغيير المسمى الوظيفي</a></li>
                                <li><hr class="dropdown-divider" ng-if="employee.Active && !hasRole(2)"></li>
                                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#exceptionModalForm" ng-click="loadException(employee.EmployeeId)" ng-if="employee.Active && !hasRole(2)">بدل استثناء</a></li>
                                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#damageModalForm" ng-click="loadDamaged(employee.EmployeeId)" ng-if="employee.Active && !hasRole(2)">استلام تلف مادة</a></li>
                                <li><hr class="dropdown-divider" ng-if="employee.Active && !hasRole(2)"></li>
                                <li><a class="dropdown-item" href="#!/issuances/{{employee.EmployeeId}}/0">سجل الصرف</a></li>
                                <li><a class="dropdown-item" href="#!/entitlements/{{employee.EmployeeId}}/0">سجل المستحقات</a></li>
                                <li><hr class="dropdown-divider" ng-if="!hasRole(2)"></li>
                                <li><a class="dropdown-item text-danger" href="" ng-click="confirmDelete(employee.EmployeeId)" ng-if="employee.Active && !hasRole(2)">استقال الموظف</a></li>
                                <li><a class="dropdown-item text-success" href="" data-bs-toggle="modal" data-bs-target="#activationModalForm" ng-click="loadActivation(employee)" ng-if="!employee.Active && !hasRole(2)">اعادة تفعيل الموظف</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

    </div>
</div>











<div class="modal fade" id="exceptionModalForm" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">اضافة استثناء</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form name="exceptionForm" novalidate>

                    <!-- Item -->
                    <div class="form-group">
                        <label>اسم المادة</label>
                        <select class="form-control"
                                ng-model="issuance.ItemId"
                                name="ItemId"
                                required
                                ng-options="i.ItemId as i.Name for i in items">
                            <option value="">اختر اسم المادة</option>
                        </select>

                        <div class="invalid-feedback d-block"
                             ng-show="exceptionForm.$submitted && exceptionForm.ItemId.$invalid">
                            يرجى اختيار مادة
                        </div>
                    </div>

                    <!-- Quantity -->
                    <div class="form-group">
                        <label>الكمية</label>
                        <input type="number"
                               class="form-control"
                               ng-model="issuance.Quantity"
                               min="1">
                    </div>

                    <!-- Reason -->
                    <div class="form-group">
                        <label>السبب</label>
                        <input type="text"
                               class="form-control"
                               ng-model="issuance.ExceptionReason">
                    </div>

                    <!-- Dropzone -->
                    <div class="form-group">
                        <label>نموذج الاستثناء</label>
                        <div id="exceptionFormDropzone"
                             class="dropzone"
                             ng-class="{'border-danger': exceptionForm.$submitted && !issuance.ExceptionFormPath}">
                        </div>

                        <!-- Hidden required input -->
                        <input type="hidden"
                               name="ExceptionFile"
                               ng-model="issuance.ExceptionFormPath"
                               required>

                        <div class="invalid-feedback d-block"
                             ng-show="exceptionForm.$submitted && !issuance.ExceptionFormPath">
                            يرجى رفع ملف
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary accept" ng-click="issueException()" type="button">
                    حفظ التغييرات
                </button>
                <button class="btn btn-danger closeBtn" data-bs-dismiss="modal">
                    إغلاق
                </button>
            </div>

        </div>
    </div>
</div>




<div class="modal fade" id="damageModalForm" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">اضافة استلام تلف مادة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form name="damageForm" novalidate>

                    <!-- Item -->
                    <div class="form-group">
                        <label>اسم المادة</label>
                        <select class="form-control"
                                ng-model="issuance.ItemId"
                                name="ItemId"
                                required
                                ng-options="i.ItemId as i.Name for i in items">
                            <option value="">اختر اسم المادة</option>
                        </select>

                        <div class="invalid-feedback d-block"
                             ng-show="damageForm.$submitted && damageForm.ItemId.$invalid">
                            يرجى اختيار مادة
                        </div>
                    </div>

                    <!-- Quantity -->
                    <div class="form-group">
                        <label>الكمية</label>
                        <input type="number"
                               class="form-control"
                               ng-model="issuance.Quantity" required
                               min="1">
                    </div>

                    <!-- Dropzone -->
                    <div class="form-group">
                        <label>نموذج الاستلام</label>
                        <div id="damageFormDropzone"
                             class="dropzone"
                             ng-class="{'border-danger': damageForm.$submitted && !issuance.SignedReceiptPath}">
                        </div>

                        <!-- Hidden required input -->
                        <input type="hidden"
                               name="SignedReceiptFile"
                               ng-model="issuance.SignedReceiptPath"
                               required>

                        <div class="invalid-feedback d-block"
                             ng-show="damageForm.$submitted && !issuance.SignedReceiptPath">
                            يرجى رفع ملف
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary accept" ng-click="issueDamage()" type="button">
                    حفظ التغييرات
                </button>
                <button class="btn btn-danger closeBtn" data-bs-dismiss="modal">
                    إغلاق
                </button>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="uploadEmployeesModal" tabindex="-1" aria-labelledby="uploadEmployeesModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalFormTitle">رفع ملف الموظفين</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div>

                    <input type="file" file-model="excelFile" accept=".xlsx" />

                </div>

                <div ng-show="uploadResult">
                    <p>Success: {{uploadResult.SuccessCount}}</p>
                    <ul>
                        <li ng-repeat="err in uploadResult.Errors">{{err}}</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button ng-click="uploadExcel()">Upload</button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="entitleMatrixModal" tabindex="-1" aria-labelledby="entitleMatrixModal" aria-hidden="true">
    <div class="modal-dialog">
        <form name="entitleForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalFormTitle">صرف لفئة كاملة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>


                <div class="modal-body">

                    <div class="form-group">
                        <label>الفئة</label>
                        <select class="form-control rounded-0 bg-light"
                                ng-model="selectedCategory"
                                ng-options="c as c.Name for c in Categories track by c.CategoryId">
                        </select>
                    </div>

                    <div class="form-group">
                        <label>سنة الاستحقاق</label>
                        <select class="form-control"
                                ng-model="selectedYear"
                                ng-options="y as y for y in years">
                            <option value="">اختر السنة</option>
                        </select>
                    </div>


                    <div class="form-group mt-3">
                        <label>إيصال الاستلام الموقّع</label>

                        <div id="signedReceiptDropzone"
                             class="dropzone"
                             ng-class="{'border-danger': signedReceiptForm.$submitted && !signedReceipt.receiptPath}">
                        </div>

                        <!-- Hidden required input -->
                        <input type="hidden"
                               name="SignedReceiptFile"
                               ng-model="signedReceipt.receiptPath"
                               required>

                        <div class="invalid-feedback d-block"
                             ng-show="signedReceiptForm.$submitted && !signedReceipt.receiptPath">
                            يرجى رفع إيصال الاستلام
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary accept" type="button" ng-disabled="isLoading"
                            ng-click="confirmIssueCategory()">
                        صرف
                    </button>
                    <button class="btn btn-danger closeBtn"
                            data-bs-dismiss="modal">
                        إغلاق
                    </button>
                </div>
            </div>
        </form>

    </div>
</div>

<div class="modal fade" id="activationModalForm" tabindex="-1" aria-labelledby="activationModalForm" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalFormTitle">اعادة تفعيل الموظف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form name="activationForm">
                    <label for="exampleFormControlInput5">تاريخ التوظيف</label>
                    <input ng-model="activation.ActivationDate" type="text" name="activationDate" class="form-control rounded-0 bg-light" placeholder="Select date" required />


                    <label for="exampleFormControlSelect12">الوحدة التنظيمية</label>
                    <select class="form-control rounded-0 bg-light" required
                            ng-model="activation.DepartmentId" name="Department"
                            ng-options="d.DepartmentId as d.Name for d in departments">
                        <option value="" disabled selected>اختر الوحدة التنظيمية</option>
                    </select>
                    <div class="invalid-feedback d-block" ng-show="activationForm.$submitted && !employee.DepartmentId">
                        <i class="bx bx-radio-circle"></i>
                        يرجى اختيار الوحدة التنظيمية
                    </div>


                    <label for="exampleFormControlSelect12">الدائرة</label>
                    <select class="form-control rounded-0 bg-light"
                            ng-model="activation.SectionId" name="Section" required
                            ng-options="s.SectionId as s.Name for s in sections">
                        <option value="" disabled selected>اختر الدائرة</option>
                    </select>
                    <div class="invalid-feedback d-block" ng-show="activationForm.$submitted && !employee.SectionId">
                        <i class="bx bx-radio-circle"></i>
                        يرجى اختيار الدائرة
                    </div>


                    <label for="exampleFormControlSelect12">المسمى الوظيفي</label>
                    <select class="form-control rounded-0 bg-light" name="JobTitle" required
                            ng-model="activation.JobTitleId"
                            ng-options="j.JobTitleId as j.Name for j in jobTitles"
                            ng-change="loadCategory(activation.JobTitleId)">
                        <option value="" disabled selected>اختر المسمى الوظيفي</option>
                    </select>
                    <div class="invalid-feedback d-block" ng-show="activationForm.$submitted && !employee.JobTitleId">
                        <i class="bx bx-radio-circle"></i>
                        يرجى اختيار المسمى الوظيفي
                    </div>
                    <label for="exampleFormControlSelect12">الفئة</label>
                    <input disabled arabic-only ng-model="jobTitleCategory.Category" type="text" name="Catgory" class="form-control rounded-0 bg-light" id="exampleFormControlInput5" placeholder="الفئة">
                </form>


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary accept" type="button" ng-disabled="isLoading"
                        ng-click="activateEmployee()">
                    تفعيل الموظف
                </button>
                <button class="btn btn-danger closeBtn"
                        data-bs-dismiss="modal">
                    إغلاق
                </button>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="exportEntitlementsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title">تصدير استحقاقات الموظفين</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">

                <label>اختر السنة</label>

                <select class="form-control"
                        ng-model="exportYear"
                        ng-options="y for y in exportYears">
                    <option value="">اختر السنة</option>
                </select>

            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button class="btn btn-success"
                        ng-disabled="!exportYear"
                        ng-click="downloadEntitlementsExcel()">

                    <i class="fa fa-file-excel"></i>
                    تحميل Excel
                </button>

                <button class="btn btn-danger"
                        data-bs-dismiss="modal">
                    إغلاق
                </button>
            </div>

        </div>
    </div>
</div>


<!-- ✅ Update Job Title Modal -->
<div class="modal fade" id="updateJobTitleModalForm" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title">تغيير المسمى الوظيفي</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">

                <div class="border small mb-3"
                     dir="rtl"
                     style="text-align:right;">

                    <p class="mb-1">
                        <strong>الموظف:</strong>
                        {{selectedEmployee.FullName}}
                    </p>

                    <p class="mb-1">
                        <strong>المسمى الحالي:</strong>
                        {{selectedEmployee.JobTitle}}
                    </p>

                    <p class="mb-1">
                        <strong>التصنيف الحالي:</strong>
                        {{selectedEmployee.Category || "—"}}
                    </p>

                    <p class="mb-1">
                        <strong>الوحدة الحالية:</strong>
                        {{selectedEmployee.Department}}
                    </p>

                    <p class="mb-0">
                        <strong>القسم الحالي:</strong>
                        {{selectedEmployee.Section || "—"}}
                    </p>

                </div>


                <!-- ✅ Form -->
                <form name="updateJobTitleForm" novalidate>



                    <!-- Department -->
                    <div class="form-group mb-3">
                        <label>الوحدة التنظيمية *</label>
                        <select class="form-control"
                                ng-model="jobTitleUpdate.DepartmentId"
                                ng-options="d.DepartmentId as d.Name for d in Departments"
                                ng-change="loadSectionsByDepartment(jobTitleUpdate.DepartmentId)"
                                required>
                            <option value="" disabled selected>اختر الوحدة التنظيمية</option>
                        </select>
                        <div class="invalid-feedback d-block" ng-show="updateJobTitleForm.$submitted && !jobTitleUpdate.DepartmentId">
                            <i class="bx bx-radio-circle"></i>
                            يرجى اختيار الوحدة التنظيمية
                        </div>
                    </div>

                    <!-- Section -->
                    <div class="form-group mb-3">
                        <label>القسم / الشعبة</label>
                        <select class="form-control"
                                ng-model="jobTitleUpdate.SectionId"
                                ng-options="s.SectionId as s.Name for s in Sections"
                                ng-change="onSectionChange(jobTitleUpdate.SectionId)">
                            <option value="">بدون قسم</option>
                        </select>
                    </div>

                    <!-- Job Title -->
                    <div class="form-group mb-3">
                        <label>المسمى الوظيفي *</label>
                        <select class="form-control"
                                ng-model="jobTitleUpdate.JobTitleId"
                                ng-options="j.JobTitleId as j.Name for j in JobTitles"
                                required
                                ng-change="loadCategory(jobTitleUpdate.JobTitleId)">
                            <option value="" disabled selected>اختر المسمى الوظيفي</option>
                        </select>
                        <div class="invalid-feedback d-block" ng-show="updateJobTitleForm.$submitted && !jobTitleUpdate.JobTitleId">
                            <i class="bx bx-radio-circle"></i>
                            يرجى اختيار المسمى الوظيفي
                        </div>
                    </div>


                    <div class="form-group mb-3">
                        <label for="exampleFormControlSelect12">التصنيف</label>
                        <input disabled arabic-only ng-model="jobTitleCategory.Category" type="text" name="Catgory" class="form-control rounded-0 bg-light" id="exampleFormControlInput5" placeholder="التصنيف">
                    </div>

                </form>

            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button class="btn btn-primary accept"
                         data-bs-dismiss="modal"
                        ng-click="saveJobTitleUpdate()">
                    حفظ التعديل
                </button>

                <button class="btn btn-secondary closeBtn"
                        data-bs-dismiss="modal">
                    إغلاق
                </button>
            </div>

        </div>
