
@{
    ViewBag.Title = "YearDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content">
    <div class="card card-default">
        @*<div class="card-header">
            <h5 class="modal-title">
                تفاصيل التخطيط لسنة {{selectedYear}}
            </h5>

        </div>*@
        <div class="card-header">
            <h3> تفاصيل تخطيط المواد لسنة {{ selectedYear }}</h3>


            <button class="btn search"
                    type="button"
                    ng-click="goBackTo('/')">
                ⬅ الرجوع إلى الصفحة الرئيسية
            </button>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3" ng-repeat="item in items">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <h5 class="card-title">{{ item.ItemName }}</h5>
                            <p class="card-text">
                                الكمية المخططة:
                                <strong>{{ item.PlannedQty }}</strong>
                            </p>
                            <p class="card-text">
                                الكمية المصروفة:
                                <strong>{{ item.IssuedQty }}</strong>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>




    </div>
    
    <div class="card card-default h-100">

        <div class="card-header">
            <h3>الموظفين لسنة {{ selectedYear }}</h3>

          
        </div>

        <div class="card-body">
            <div class="row mb-3">

                <div class="col-3">
                    <label>الرقم الوظيفي</label>
                    <input type="text" ng-model="employeeYearTableParams.filter().EmployeeNumber" placeholder="الرقم الوظيفي" class="form-control" />
                </div>


                <div class="col-3">
                    <label>الاسم</label>
                    <input type="text" ng-model="employeeYearTableParams.filter().EmployeeName" placeholder="الاسم" class="form-control" />
                </div>


                <div class="col-3">
                    <label>التصنيف</label>
                    <select class="form-control" name="JobTitle"
                            ng-model="employeeYearTableParams.filter().CategoryId"
                            ng-options="c.CategoryId as c.Name for c in Categories">
                        <option value="">الكل</option>
                    </select>
                </div>

                <div class="col-3">
                    <label>الحالة</label>
                    <select class="form-control" name="JobTitle"
                            ng-model="employeeYearTableParams.filter().IsIssued">
                        <option value="">الكل</option>
                        <option value="true">مستلم</option>
                        <option value="false">غير مستلم</option>
                    </select>
                </div>

            </div>


            <table ng-table="employeeYearTableParams"
                   class="table table-bordered table-striped text-center">


                <thead>
                    <tr>
                        <th>الرقم الوظيفي</th>
                        <th>اسم الموظف</th>
                        <th>التصنيف</th>
                        <th>الكمية المخططة</th>
                        <th>الكمية المصروفة</th>
                        <th>الكمية المتبقية</th>
                        <th>الحالة</th>
                        <th>الاجرائات</th>
                    </tr>
                </thead>


                <tbody>
                    <tr class="t-hover" ng-repeat="row in $data">

                        <td>{{row.EmployeeNumber}}</td>
                        <td>{{row.EmployeeName}}</td>
                        <td>{{row.Category}}</td>

                        <td>{{row.TotalEntitled}}</td>

                        <td>{{row.TotalIssued}}</td>

                        <td>{{row.TotalRemaining}}</td>
                        <td>
                            <span class="text-success" ng-show="row.IsIssued">مستلم</span>
                            <span class="text-danger" ng-show="!row.IsIssued">غير مستلم</span>
                        </td>

                        <td>
                            <div class="btn-group" role="group" aria-label="Basic example" dir="ltr">
                                <button type="button" class="btn btn-outline-dark btn-pill" ng-click="goToEntitlements(row.EmployeeId,selectedYear)">سجل المستحقات</button>
                                <button type="button" class="btn btn-outline-dark btn-pill" ng-click="goToIssuances(row.EmployeeId,selectedYear)">سجل الصرف</button>
                            </div>
                        </td>
                    </tr>
                </tbody>

            </table>

            <div ng-show="planningData.length === 0"
                 class="text-danger text-center mt-2">
                لا توجد بيانات
            </div>

        </div>
    </div>
    
</div>

   





