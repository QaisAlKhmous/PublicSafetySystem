
@{
    ViewBag.Title = "YearDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content">
    <div class="card card-default">
        @*<div class="card-header">
            <h5 class="modal-title">
                تفاصيل التخطيط لسنة {{selectedYear}}
            </h5>

        </div>*@
        <div class="card-header">
            <h3> تفاصيل تخطيط المواد لسنة {{selectedYear}}</h3>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3" ng-repeat="item in items">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <h5 class="card-title">{{ item.ItemName }}</h5>
                            <p class="card-text">
                                الكمية المخططة:
                                <strong>{{ item.PlannedQty }}</strong>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>




    </div>
    
    <div class="card card-default h-100">

        <div class="card-header">
            <h3>الموظفين المستحقين لسنة {{selectedYear}}</h3>

          
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-5">
                    <input type="text" ng-model="employeeYearTableParams.filter().EmployeeName" placeholder="الاسم" class="form-control" />
                </div>


                <div class="col-3">
                    <select class="form-control" name="JobTitle"
                            ng-model="employeeYearTableParams.filter().CategoryId"
                            ng-options="c.CategoryId as c.Name for c in Categories">
                        <option value="">الكل</option>
                    </select>
                </div>

            </div>


            <table ng-table="employeeYearTableParams"
                   class="table table-bordered table-striped text-center"
                   style="cursor:pointer;">


                <thead>
                    <tr>
                        <th>اسم الموظف</th>
                        <th>الفئة</th>
                        <th>الكمية المخططة</th>
                        <th>الكمية المصروفة</th>
                        <th>الكمية المتبقية</th>
                    </tr>
                </thead>


                <tbody>
                    <tr class="t-hover" ng-repeat="row in $data">

                        <td>{{row.EmployeeName}}</td>
                        <td>{{row.Category}}</td>

                        <td>{{row.TotalEntitled}}</td>

                        <td>{{row.TotalIssued}}</td>

                        <td>
                            {{row.TotalRemaining}}
                        </td>
                    </tr>
                </tbody>

            </table>

            <div ng-show="planningData.length === 0"
                 class="text-danger text-center mt-2">
                لا توجد بيانات
            </div>

        </div>
    </div>
    
</div>

   





